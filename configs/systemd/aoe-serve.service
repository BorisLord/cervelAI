[Unit]
Description=Agent of Empires web dashboard (LAN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# PATH includes mise shims so aoe finds agent binaries installed per-user via npm/mise.
Environment="PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin"
# mise shim so `mise upgrade aoe` takes effect on next restart.
ExecStart=%h/.local/share/mise/shims/aoe serve --host 0.0.0.0
Restart=on-failure
RestartSec=5s

# PrivateTmp omitted: aoe shares tmux sockets in /tmp with user shells; isolating breaks SSH attach.
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=default.target
