# pnpm v9+ blocks dependency postinstall scripts by default (supply-chain mitigation).
# CLI agents below ship a native binary downloaded via postinstall — without this
# whitelist, install completes but the binary is non-functional.
# Note: pnpm 11.1.2's `dangerouslyAllowAllBuilds` setting was not honored when invoked
# via mise (Nov 2025), hence the explicit per-package whitelist.
onlyBuiltDependencies[]=opencode-ai
onlyBuiltDependencies[]=@openai/codex
onlyBuiltDependencies[]=@google/gemini-cli
onlyBuiltDependencies[]=@github/copilot
onlyBuiltDependencies[]=@anthropic-ai/claude-code
onlyBuiltDependencies[]=@qwen-code/qwen-code
onlyBuiltDependencies[]=@vibe-kit/grok-cli
onlyBuiltDependencies[]=@continuedev/cli
onlyBuiltDependencies[]=@earendil-works/pi-coding-agent
onlyBuiltDependencies[]=deepseek-tui
onlyBuiltDependencies[]=@agents-dev/cli
