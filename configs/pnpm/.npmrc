# pnpm v9+ blocks dependency postinstall scripts by default (supply-chain mitigation).
# Whitelist only the 3 agent packages that actually have a postinstall (`npm view <pkg> scripts`);
# the others rely on optionalDependencies for platform binaries — no script to allow.
# Note: pnpm v11+ may ignore this file for `onlyBuiltDependencies` (docs say only auth/registry
# settings load from `.npmrc`); migrate to pnpm-workspace.yaml if installs break under v11.
onlyBuiltDependencies[]=opencode-ai
onlyBuiltDependencies[]=@anthropic-ai/claude-code
onlyBuiltDependencies[]=deepseek-tui
