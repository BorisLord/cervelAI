#!/usr/bin/env bash
set -uo pipefail

# Non-interactive shells don't load .bashrc; activate mise shims so agent binaries resolve.
command -v mise >/dev/null 2>&1 && eval "$(mise activate bash --shims)"
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH" ;;
esac

env_file="$HOME/.config/cervelAI/env"
# shellcheck source=/dev/null
[ -r "$env_file" ] && . "$env_file"

[ "$#" -eq 0 ] && {
    echo "usage: cervel-run <cmd> [args...]" >&2
    exit 2
}

ntfy_server="${NTFY_SERVER:-https://ntfy.sh}"
ntfy_topic="${NTFY_TOPIC:-}"
host="$(hostname)"
cmd="$*"
start="$(date +%s)"

"$@"
rc=$?

dur=$(($(date +%s) - start))

if [ -n "$ntfy_topic" ]; then
    if [ "$rc" -eq 0 ]; then
        title="cervel-run OK ($host)"
        prio="default"
    else
        title="cervel-run FAILED rc=$rc ($host)"
        prio="high"
    fi
    curl -fsS -m 10 \
        -H "Title: $title" \
        -H "Priority: $prio" \
        -d "$cmd  (${dur}s)" \
        "$ntfy_server/$ntfy_topic" >/dev/null 2>&1 ||
        echo "cervel-run: ntfy notification failed (network?)" >&2
else
    echo "cervel-run: NTFY_TOPIC empty in $env_file, no notification" >&2
fi

exit "$rc"
