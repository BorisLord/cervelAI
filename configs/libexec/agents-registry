# shellcheck shell=bash
# Sourced (never executed) by install scripts and libexec/status + libexec/cervel.
# Format "<package>:<binary>": package = mise id, binary = command probed on PATH.
# Keys in per-attribute maps (API keys, prompt paths) must be a subset of this list.
CERVELAI_AGENTS_REGISTRY=(
    "claude-code:claude"
    "codex:codex"
    "opencode:opencode"
    "pi:pi"
    "copilot-cli:copilot"
    "crush:crush"
    "gemini-cli:gemini"
    "goose:goose"
    "continue:cn"
    "qwen-code:qwen"
    "mistral-vibe:vibe"
    "deepseek-tui:deepseek"
)

cervelai_agent_packages_csv() {
    local IFS=, e
    local -a a=()
    for e in "${CERVELAI_AGENTS_REGISTRY[@]}"; do a+=("${e%%:*}"); done
    printf '%s' "${a[*]}"
}

cervelai_agent_bins() {
    local e
    local -a a=()
    for e in "${CERVELAI_AGENTS_REGISTRY[@]}"; do a+=("${e##*:}"); done
    printf '%s' "${a[*]}"
}
