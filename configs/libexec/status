#!/usr/bin/env bash
set -u

_LIBEXEC="$(dirname "$(readlink -f "$0")")"

if command -v tmux >/dev/null 2>&1; then
    _MUX=tmux
elif command -v zellij >/dev/null 2>&1; then
    _MUX=zellij
else
    _MUX=none
fi

_mux_list() {
    case "$_MUX" in
        tmux) tmux ls 2>/dev/null ;;
        zellij) zellij list-sessions 2>/dev/null ;;
        *) echo "(no multiplexer installed)" ;;
    esac
}

_manifest="$HOME/.config/cervelAI/manifest"
# shellcheck source=/dev/null
[ -r "$_manifest" ] && . "$_manifest"

[ -r "$_LIBEXEC/logo" ] && bash "$_LIBEXEC/logo"
printf '\n'

printf '── host ──\n'
_ip=$(ip -4 -o addr show 2>/dev/null | awk '$3=="inet" && $4!~/^127\./ {print $4}' | head -1 | cut -d/ -f1)
_uptime=$(uptime -p 2>/dev/null)
printf '  host:    %s@%s (%s)\n' "$(whoami)" "$(hostname)" "${_ip:-?}"
printf '  uptime:  %s\n' "${_uptime:-?}"
[ -n "${CERVELAI_SHELL:-}" ] && printf '  stack:   %s + %s\n' "$CERVELAI_SHELL" "${CERVELAI_MULTIPLEXER:-?}"
printf '\n'

if [ -n "${CERVELAI_CATEGORIES:-}" ]; then
    printf '── installed categories ──\n  %s\n\n' "${CERVELAI_CATEGORIES// / · }"
fi

printf '── %s sessions ──\n' "$_MUX"
_sessions=$(_mux_list)
[[ -n "$_sessions" ]] && printf '%s\n' "$_sessions" || printf '  (no session)\n'
printf '\n'

if command -v aoe >/dev/null 2>&1; then
    printf '── aoe sessions ──\n'
    _aoe_sessions=$(aoe list 2>/dev/null | head -10)
    [[ -n "$_aoe_sessions" ]] && printf '%s\n' "$_aoe_sessions" || printf '  (none)\n'
    printf '\n'
fi

# Every installed service that serves a web UI — open these in a browser.
printf '── dashboards ──\n'
_dash=0
if command -v aoe >/dev/null 2>&1; then
    _dash=1
    _aoe_url=$(aoe url 2>/dev/null)
    printf '  aoe          %s\n' "${_aoe_url:-(aoe-serve.service not running)}"
fi
if command -v paperclipai >/dev/null 2>&1; then
    _dash=1
    printf '  paperclip    http://%s:3100  (login — bootstrap admin: paperclipai auth bootstrap-ceo)\n' "${_ip:-<host-ip>}"
fi
if command -v code-server >/dev/null 2>&1; then
    _dash=1
    _cs_pw=$(awk '/^password:/{print $2}' "$HOME/.config/code-server/config.yaml" 2>/dev/null)
    printf '  code-server  http://%s:8081  (password: %s)\n' "${_ip:-<host-ip>}" "${_cs_pw:-see ~/.config/code-server/config.yaml}"
fi
((_dash)) || printf '  (none installed)\n'
printf '\n'

printf '── ntfy (cervel run notifications) ──\n'
if [[ -n "${NTFY_TOPIC:-}" ]]; then
    printf '  %s/%s\n' "${NTFY_SERVER:-https://ntfy.sh}" "$NTFY_TOPIC"
else
    printf '  (NTFY_TOPIC empty in ~/.config/cervelAI/env)\n'
fi
printf '\n'

printf '── AI agents installed ──\n'
_found=()
# shellcheck source=/dev/null
[ -r "$_LIBEXEC/agents-registry" ] && . "$_LIBEXEC/agents-registry"
for a in $(cervelai_agent_bins 2>/dev/null); do
    command -v "$a" >/dev/null 2>&1 && _found+=("$a")
done
if ((${#_found[@]} > 0)); then
    _agents="${_found[*]}"
    printf '  %s\n' "${_agents// / · }"
else
    printf '  (none installed)\n'
fi
printf '\n'

printf '── system ──\n'
printf '  mem:    %s\n' "$(free -h 2>/dev/null | awk '/^Mem:/{print $3"/"$2}')"
printf '  load:   %s\n' "$(uptime 2>/dev/null | awk -F'load average: ' '{print $2}')"
printf '  disk:   %s\n' "$(df -h / 2>/dev/null | awk 'NR==2{print $3"/"$2" ("$5" used)"}')"
printf '  stores: pnpm=%s  mise=%s\n' \
    "$(du -sh "$HOME/.local/share/pnpm" 2>/dev/null | awk '{print $1}')" \
    "$(du -sh "$HOME/.local/share/mise" 2>/dev/null | awk '{print $1}')"
