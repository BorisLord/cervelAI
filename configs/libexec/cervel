#!/usr/bin/env bash
# cervel: dispatcher CLI (installed to ~/.local/bin/cervel via libexec symlink).
# Works in any shell — interactive, non-interactive, cron, ssh `cmd`, etc.
set -u
LIBEXEC="$(dirname "$(readlink -f "$0")")"
case "${1:-}" in
    help | -h) exec "$LIBEXEC/cheatsheet" ;;
    status | -s) exec "$LIBEXEC/status" ;;
    run)
        shift
        exec "$LIBEXEC/run" "$@"
        ;;
    ls)
        # shellcheck source=/dev/null
        [ -r "$LIBEXEC/agents-registry" ] && . "$LIBEXEC/agents-registry"
        for a in $(cervelai_agent_bins 2>/dev/null); do
            command -v "$a" >/dev/null 2>&1 && printf '  %s\n' "$a"
        done
        # `true`: the final loop iteration leaks its rc, so a missing last agent would exit 1.
        true
        ;;
    *)
        printf 'usage: cervel {help|-h | status|-s | ls | run <cmd>}\n' >&2
        exit 2
        ;;
esac
