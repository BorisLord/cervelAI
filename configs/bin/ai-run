#!/usr/bin/env bash
# ai-run <cmd> [args...]: run a command (an AI agent), ntfy-notify on exit.
#   ai-run claude -p "implement X"
# Reads NTFY_SERVER / NTFY_TOPIC from ~/.config/cervelAI/env. Empty topic: no notification.
set -uo pipefail

env_file="$HOME/.config/cervelAI/env"
# shellcheck source=/dev/null
[ -r "$env_file" ] && . "$env_file"

[ "$#" -eq 0 ] && {
    echo "usage: ai-run <cmd> [args...]" >&2
    exit 2
}

ntfy_server="${NTFY_SERVER:-https://ntfy.sh}"
ntfy_topic="${NTFY_TOPIC:-}"
host="$(hostname)"
cmd="$*"
start="$(date +%s)"

"$@"
rc=$?

dur=$(($(date +%s) - start))

if [ -n "$ntfy_topic" ]; then
    if [ "$rc" -eq 0 ]; then
        title="ai-run OK ($host)"
        prio="default"
    else
        title="ai-run FAILED rc=$rc ($host)"
        prio="high"
    fi
    curl -fsS -m 10 \
        -H "Title: $title" \
        -H "Priority: $prio" \
        -d "$cmd  (${dur}s)" \
        "$ntfy_server/$ntfy_topic" >/dev/null 2>&1 ||
        echo "ai-run: ntfy notification failed (network?)" >&2
else
    echo "ai-run: NTFY_TOPIC empty in $env_file, no notification" >&2
fi

exit "$rc"
