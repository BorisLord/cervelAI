#!/usr/bin/env bash
# cervelai-menu: launcher invoked by /etc/profile.d/cervelai-entry.sh.
set -u

export GUM_CHOOSE_HEADER_FOREGROUND="14"
export GUM_CHOOSE_CURSOR_FOREGROUND="11"
export GUM_CHOOSE_SELECTED_FOREGROUND="10"

if command -v tmux >/dev/null 2>&1; then
    _MUX=tmux
elif command -v zellij >/dev/null 2>&1; then
    _MUX=zellij
else
    _MUX=none
fi

_mux_attach_last() {
    case "$_MUX" in
        tmux)
            local last
            last=$(tmux ls -F '#{session_last_attached}'$'\t''#{session_name}' 2>/dev/null |
                sort -nr | awk -F'\t' 'NR==1{print $2}')
            [[ -n "$last" ]] && exec tmux attach -t "$last"
            ;;
        zellij)
            # zellij has no last-attached notion: takes first in creation order.
            local last
            last=$(zellij list-sessions -s 2>/dev/null | head -1)
            [[ -n "$last" ]] && exec zellij attach "$last"
            ;;
    esac
    return 1
}

_mux_new_or_attach() {
    local name="$1"
    case "$_MUX" in
        tmux) exec tmux new-session -A -s "$name" ;;
        zellij) exec zellij attach -c "$name" ;;
        *) exec bash ;;
    esac
}

_mux_list() {
    case "$_MUX" in
        tmux) tmux ls 2>/dev/null ;;
        zellij) zellij list-sessions 2>/dev/null ;;
        *) echo "(no multiplexer installed)" ;;
    esac
}

run_resume() {
    _mux_attach_last && return
    if command -v aoe >/dev/null 2>&1; then
        exec aoe
    fi
    echo "no session to resume, no aoe available, opening a fresh shell"
    _mux_new_or_attach shell
}

run_agents() {
    if ! command -v aoe >/dev/null 2>&1; then
        echo "aoe not installed, falling back to a multiplexer session named 'agents'"
        _mux_new_or_attach agents
    fi
    exec aoe
}

run_shell() {
    _mux_new_or_attach shell
}

run_status() {
    clear 2>/dev/null
    printf '═══ cervelai status ═══\n\n'

    printf '── %s sessions ──\n' "$_MUX"
    local _sessions
    _sessions=$(_mux_list)
    [[ -n "$_sessions" ]] && printf '%s\n' "$_sessions" || printf '  (no session)\n'
    printf '\n'

    if command -v aoe >/dev/null 2>&1; then
        local _aoe_sessions _aoe_url
        printf '── aoe sessions ──\n'
        _aoe_sessions=$(aoe list 2>/dev/null | head -10)
        [[ -n "$_aoe_sessions" ]] && printf '%s\n' "$_aoe_sessions" || printf '  (none)\n'
        printf '\n── aoe dashboard ──\n'
        _aoe_url=$(aoe url 2>/dev/null)
        [[ -n "$_aoe_url" ]] && printf '%s\n' "$_aoe_url" || printf '  (aoe-serve.service not running)\n'
    else
        printf '── aoe ──\n  (not installed)\n'
    fi
    printf '\n'

    printf '── system ──\n'
    printf '  mem:  %s\n' "$(free -h 2>/dev/null | awk '/^Mem:/{print $3"/"$2}')"
    printf '  load: %s\n' "$(uptime 2>/dev/null | awk -F'load average: ' '{print $2}')"
    printf '  disk: %s\n' "$(df -h / 2>/dev/null | awk 'NR==2{print $3"/"$2" ("$5" used)"}')"
    printf '\n'
    read -rp '(Enter to return to menu) ' _ </dev/tty
}

run_update() {
    if ! command -v topgrade >/dev/null 2>&1; then
        echo "topgrade not installed; install via mise or run 'apt update && apt upgrade' manually"
        sleep 2
        return
    fi
    topgrade
    read -rp '(Enter to return to menu) ' _ </dev/tty
}

run_plain_shell() {
    export CERVELAI_NO_MENU=1
    exec bash
}

_print_cheatsheet() {
    case "$_MUX" in
        tmux) printf '\n  tmux:    ^B d (detach)  c (new win)  %% " (split V/H)  s (sessions)  [ (scroll, q exit)\n' ;;
        zellij) printf '\n  zellij:  Ctrl+P d (detach)  Ctrl+N (new tab)  Ctrl+P n (new pane)  Ctrl+S (search)\n' ;;
        *) printf '\n  shell:   (no multiplexer installed)\n' ;;
    esac
    if command -v aoe >/dev/null 2>&1; then
        printf '  aoe:     aoe add --cmd <agent>  |  aoe list  |  aoe url (dashboard)  |  aoe agents\n'
    fi
    printf '\n'
}

SHELL_LABEL="shell ($_MUX)"
if command -v aoe >/dev/null 2>&1; then
    AGENTS_LABEL="agents (aoe)"
else
    AGENTS_LABEL="agents (no aoe, $_MUX fallback)"
fi

_print_logo() {
    printf '\033[1;36m'
    cat <<'LOGO'
                         _  ___  _____
                        | |/ _ \|_   _|
  ___ ___ _ ____   _____| / /_\ \ | |
 / __/ _ \ '__\ \ / / _ \ |  _  | | |
| (_|  __/ |   \ V /  __/ | | | |_| |_
 \___\___|_|    \_/ \___|_\_| |_/\___/
LOGO
    printf '\033[0m'
}

_print_logo
while :; do
    _print_cheatsheet
    if command -v gum >/dev/null 2>&1; then
        choice=$(gum choose --header "cervelai entry" \
            "resume (last session)" \
            "$AGENTS_LABEL" \
            "$SHELL_LABEL" \
            "status" \
            "update (topgrade)" \
            "plain shell") || run_plain_shell
        case "$choice" in
            "resume (last session)") run_resume ;;
            "$AGENTS_LABEL") run_agents ;;
            "$SHELL_LABEL") run_shell ;;
            "status") run_status ;;
            "update (topgrade)") run_update ;;
            "plain shell") run_plain_shell ;;
            *)
                printf 'unknown choice: %s\n' "$choice"
                sleep 1
                ;;
        esac
    else
        cat <<EOF
=== cervelai ===
  [r] resume (last session)
  [a] $AGENTS_LABEL
  [s] $SHELL_LABEL
  [i] status (info)
  [u] update (topgrade)
  [q] plain shell (skip menu)
EOF
        read -rp '> ' ans </dev/tty
        case "$ans" in
            r | R) run_resume ;;
            a | A) run_agents ;;
            s | S) run_shell ;;
            i | I) run_status ;;
            u | U) run_update ;;
            q | Q | '') run_plain_shell ;;
            *)
                echo "unknown: $ans"
                sleep 1
                ;;
        esac
    fi
done
